+/* --- Уровень 3: политика гостевых системных вызовов --- */
+static int sbx_blocked_open_path(const char *p)
+{
+    if (!p) return 0;
+    if (strcmp(p, "/proc/self/mem") == 0) return 1;
+    if (strcmp(p, "/proc/thread-self/mem") == 0) return 1;
+    {
+        char self[64];
+        int n = snprintf(self, sizeof self, "/proc/%d/mem", (int)getpid());
+        if (n > 0 && (size_t)n < sizeof self && strcmp(p, self) == 0) return 1;
+    }
+    return 0;
+}
